# ==============================================================================
# Document Automation API - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Ollama Endpoint
# Local non-Docker: http://localhost:11434
# Docker Compose:   http://ollama:11434
OLLAMA_URL=http://localhost:11434

# LLM & Embedding Models
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
LLM_TEMPERATURE=0
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=2048
LLM_TIMEOUT_SEC=600
LLM_MAX_RETRIES=2

# OCR & Document Processing
OCR_LANGUAGES=["en"]
PDF_DPI=250
MAX_FILE_MB=10
MAX_PAGES=10

# Label RAG & Hints Engine
HINTS_ENABLED=true
FUZZY_MATCH_MIN=90
VECTOR_TOP_K=3
VECTOR_SIM_THRESHOLD=0.75
MIN_LABEL_COUNT=1
PROMPT_VERSION=v1

# Authentication (Change for production)
API_KEY=change-me

# Storage Root Directory (SQLite, ChromaDB, temporary files, outputs)
DATA_DIR=data
